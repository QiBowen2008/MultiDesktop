object frmLauncher: TfrmLauncher
  Left = 405
  Height = 338
  Top = 240
  Width = 484
  BorderStyle = bsDialog
  Caption = '多桌面助手'
  ClientHeight = 338
  ClientWidth = 484
  Position = poScreenCenter
  OnCreate = FormCreate
  object lblTitle: TLabel
    Left = 20
    Height = 21
    Top = 18
    Width = 90
    Caption = '选择桌面'
    Font.CharSet = DEFAULT_CHARSET
    Font.Height = -16
    Font.Name = 'Microsoft YaHei UI'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lvDesktops: TListView
    Left = 24
    Height = 200
    Top = 55
    Width = 432
    Columns = <    
      item
        Caption = '桌面名称'
        Width = 180
      end    
      item
        Caption = '桌面路径'
        Width = 248
      end>
    Font.CharSet = DEFAULT_CHARSET
    Font.Height = -13
    Font.Name = 'Microsoft YaHei UI'
    GridLines = True
    HideSelection = False
    MultiSelect = False
    ReadOnly = True
    RowSelect = True
    ParentFont = False
    TabOrder = 0
    ViewStyle = vsReport
    OnDblClick = lvDesktopsDblClick
  end
  object btnSwitch: TButton
    Left = 24
    Height = 40
    Top = 275
    Width = 220
    Caption = '切换桌面'
    Font.CharSet = DEFAULT_CHARSET
    Font.Height = -13
    Font.Name = 'Microsoft YaHei UI'
    ParentFont = False
    TabOrder = 1
    OnClick = btnSwitchClick
  end
  object btnManage: TButton
    Left = 256
    Height = 40
    Top = 275
    Width = 204
    Caption = '管理桌面...'
    Font.CharSet = DEFAULT_CHARSET
    Font.Height = -13
    Font.Name = 'Microsoft YaHei UI'
    ParentFont = False
    TabOrder = 2
    OnClick = btnManageClick
  end
end
